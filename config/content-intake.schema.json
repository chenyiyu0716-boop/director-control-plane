{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chief.local/schemas/content-intake.json",
  "title": "Chief Content Intake",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectId", "intakeType", "subjectName", "objective", "targetStage", "sources", "assertions"],
  "properties": {
    "projectId": {"type": "string", "minLength": 1},
    "intakeType": {"enum": ["knowledge_ingest", "candidate_research"]},
    "subjectName": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "targetStage": {"enum": ["candidate", "knowledge", "story_ready", "brief"]},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["sourceUri"],
        "properties": {
          "sourceUri": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
        }
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind", "statement"],
        "properties": {
          "kind": {"enum": ["fact", "quote", "analysis"]},
          "statement": {"type": "string", "minLength": 1, "maxLength": 1000},
          "sourceUri": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
